        given-names: Jingwen
      - family-names: Kelly
        given-names: Bryan
      - family-names: Xiu
        given-names: Dacheng
    title: "(Re-)Imag(in)ing Price Trends"
    year: 2023
    journal: "The Journal of Finance"
    volume: 78
    issue: 6
    start: 3193
    end: 3249
    doi: "10.1111/jofi.13268"
